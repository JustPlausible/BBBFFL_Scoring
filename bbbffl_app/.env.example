# Copy to .env and fill in for local/home-server use. Never commit the real .env.
#
# app/config.py is the single validated settings boundary that reads all of
# these -- see its module docstring for the full precedence/validation
# rules, and docs/settings.md for the production/development/replay
# requirements summary. BBBFFL_ENVIRONMENT=production enforces several of
# the variables below as required (never satisfied by a development
# default) and rejects a handful of permissive dev-only values outright.

# "development" (default), "test", or "production". Leave unset for local/
# home-server use -- that is exactly today's permissive prototype
# behaviour (open admin interface, local SQLite, localhost afl-api all
# remain valid). Set to "production" for a real deployment: this enforces
# BBBFFL_DATABASE_URL (PostgreSQL), BBBFFL_PUBLIC_BASE_URL,
# BBBFFL_ADMIN_TOKEN and AFL_API_BASE_URL below as required, and refuses
# BBBFFL_AFL_MODE=replay.
BBBFFL_ENVIRONMENT=development

# Base URL of the afl-api service (no trailing slash). Required in
# production -- there is no default afl-api endpoint for a real deployment.
AFL_API_BASE_URL=http://afl-api:8000

# Sent as the x-api-key header to afl-api, if it requires one. Leave unset if not.
AFL_API_KEY=

# Which afl-api consumer contract BBBFFL expects (see
# docs/afl-api-v1-contract.md, issue #18). Currently only "v1" is
# implemented; an unsupported value fails at startup rather than BBBFFL
# silently requesting a contract version it does not actually speak.
AFL_API_CONTRACT_VERSION=v1

AFL_API_TIMEOUT_SECONDS=10

# Optional: split the single timeout above into an explicit connect budget
# (can afl-api even be reached) and read budget (how long may a response
# take once connected). Leave unset to use AFL_API_TIMEOUT_SECONDS for both
# -- see docs/afl-client-resilience.md.
AFL_API_CONNECT_TIMEOUT_SECONDS=
AFL_API_READ_TIMEOUT_SECONDS=

# Bounded transient retry/backoff around afl-api requests. Only applies to
# connection failures, timeouts and transient (408/429/5xx) responses --
# never to a contract/schema-incompatible response. See
# docs/afl-client-resilience.md.
AFL_API_RETRY_MAX_ATTEMPTS=3
AFL_API_RETRY_BASE_DELAY_SECONDS=0.2
AFL_API_RETRY_MAX_DELAY_SECONDS=2.0

# "live" (default) talks to the configured afl-api deployment above.
# "replay" declares a deterministic/replay run (roadmap package 32) and
# requires BBBFFL_AFL_REPLAY_EVIDENCE_PATH too -- replay/deterministic
# execution must never silently fall back to live afl-api access just
# because that path was left unset. Refused outright when
# BBBFFL_ENVIRONMENT=production. No replay-backed AFL data source exists
# yet, so setting "replay" today makes the application refuse to start at
# all (see docs/settings.md) rather than fall back to live access.
BBBFFL_AFL_MODE=live
BBBFFL_AFL_REPLAY_EVIDENCE_PATH=

# Production: PostgreSQL, e.g.
# postgresql+psycopg://user:password@database/bbbffl -- required (and must
# be PostgreSQL, not SQLite) when BBBFFL_ENVIRONMENT=production. For local
# SQLite this path must be on a mounted volume. BBBFFL_DB_PATH remains a
# fallback when this URL is omitted (development/test only).
BBBFFL_DATABASE_URL=sqlite:///./data/scorer_decisions.db
BBBFFL_DB_PATH=./data/scorer_decisions.db

# The externally reachable base URL of this deployment, e.g.
# https://bbbffl.example.com. Required when BBBFFL_ENVIRONMENT=production.
BBBFFL_PUBLIC_BASE_URL=

# Coach-declared Grand Final team selection (checked-in JSON, not scorer state).
BBBFFL_TEAMS_CONFIG_PATH=./data/grand_final_teams.json

# Shared secret required as the X-Admin-Token header on all /api/admin/* routes.
# Leave unset to run the admin interface without a token (fine for a private
# home-server network only). Required when BBBFFL_ENVIRONMENT=production --
# a production deployment refuses to start with the admin interface open
# to any caller.
BBBFFL_ADMIN_TOKEN=

# Coach authentication (roadmap package 19, issue #74) -- see
# docs/coach-authentication.md. Signs CSRF tokens for the sign-in/sign-out
# forms. Leave unset for local/home-server use: a fixed, clearly-labelled
# development placeholder is used automatically. Required when
# BBBFFL_ENVIRONMENT=production, and that placeholder value is refused
# outright there -- generate a real random value, e.g. `openssl rand -hex 32`.
BBBFFL_SESSION_SECRET=

# How long a coach's signed-in session lasts before it must be re-established,
# in seconds. Defaults to 12 hours.
BBBFFL_SESSION_LIFETIME_SECONDS=43200

# How often the public page polls for updates, in seconds.
BBBFFL_POLL_INTERVAL_SECONDS=25

BBBFFL_LOG_LEVEL=INFO

# Opt-in experimental SuperScore competition (see README.md#superscore).
# Leave unset to keep SuperScore fully disabled -- the app then behaves
# exactly as it does without this feature. Set it to a checked-in JSON
# entries file (copy data/superscore_teams.example.json) to enable it.
BBBFFL_SUPERSCORE_CONFIG_PATH=
