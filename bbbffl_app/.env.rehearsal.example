# Round 1 rehearsal only. Copy this file to .env.rehearsal; do not reuse it
# for a live or production deployment.
BBBFFL_ENVIRONMENT=development
BBBFFL_DATABASE_URL=postgresql+psycopg://bbbffl:rehearsal-only@database/bbbffl_round1_rehearsal
BBBFFL_AFL_MODE=replay
BBBFFL_AFL_REPLAY_EVIDENCE_PATH=/replay/evidence/round1-2026-rehearsal-evidence.json

# Rehearsal mode never contacts afl-api, but this remains a valid URL for the
# common settings boundary.
AFL_API_BASE_URL=http://afl-api:8000

# Replace these before exposing the rehearsal beyond a trusted private host.
BBBFFL_ADMIN_TOKEN=
BBBFFL_SESSION_SECRET=round1-rehearsal-only-change-me
