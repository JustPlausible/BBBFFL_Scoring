# Copy to .env and fill in for local/home-server use. Never commit the real .env.

# Base URL of the afl-api service (no trailing slash).
AFL_API_BASE_URL=http://afl-api:8000

# Sent as the x-api-key header to afl-api, if it requires one. Leave unset if not.
AFL_API_KEY=

AFL_API_TIMEOUT_SECONDS=10

# Production: PostgreSQL. For local SQLite this path must be on a mounted
# volume. BBBFFL_DB_PATH remains a fallback when this URL is omitted.
BBBFFL_DATABASE_URL=sqlite:///./data/scorer_decisions.db
BBBFFL_DB_PATH=./data/scorer_decisions.db

# Coach-declared Grand Final team selection (checked-in JSON, not scorer state).
BBBFFL_TEAMS_CONFIG_PATH=./data/grand_final_teams.json

# Shared secret required as the X-Admin-Token header on all /api/admin/* routes.
# Leave unset to run the admin interface without a token (fine for a private
# home-server network only).
BBBFFL_ADMIN_TOKEN=

# How often the public page polls for updates, in seconds.
BBBFFL_POLL_INTERVAL_SECONDS=25

BBBFFL_LOG_LEVEL=INFO

# Opt-in experimental SuperScore competition (see README.md#superscore).
# Leave unset to keep SuperScore fully disabled -- the app then behaves
# exactly as it does without this feature. Set it to a checked-in JSON
# entries file (copy data/superscore_teams.example.json) to enable it.
BBBFFL_SUPERSCORE_CONFIG_PATH=
