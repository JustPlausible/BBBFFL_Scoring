# Ignore credentials and Clasp settings
.clasp.json
.classpath
.project
.settings/
node_modules/
.vscode/
.env
.DS_Store

# Ignore build or temp files if using TypeScript or bundlers
dist/
build/

# Python virtual environments
.venv/
venv/
__pycache__/
*.pyc

# Production deployment (issue #243): real backups, never committed --
# deploy/production/backups/ is a bind-mount target compose.production.yaml
# writes real pg_dump files into. .gitkeep keeps the directory present in
# a checkout so an operator does not have to invent the path.
deploy/production/backups/*
!deploy/production/backups/.gitkeep
deploy/production/Caddyfile
*.dump
