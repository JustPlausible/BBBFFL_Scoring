# Copy to .env.second-half-replay; never reuse the first-half or synthetic
# rehearsal env. BBBFFL_AFL_REPLAY_EVIDENCE_PATH names the second-half
# evidence package once it exists (see docs/2026-second-half-replay-playbook.md
# section on AFL evidence acquisition); it deliberately does not point at the
# first-half package, which stops at AFL round 1352.
BBBFFL_ENVIRONMENT=development
BBBFFL_DATABASE_URL=postgresql+psycopg://bbbffl:second-half-only@database/bbbffl_2026_second_half
BBBFFL_AFL_MODE=replay
BBBFFL_AFL_REPLAY_EVIDENCE_PATH=/replay/evidence/2026-second-half.json
BBBFFL_AFL_REPLAY_CHECKPOINT_PATH=/replay/state/checkpoint.json
AFL_API_BASE_URL=http://deliberately-unavailable.invalid
BBBFFL_SESSION_SECRET=second-half-replay-change-me
BBBFFL_ADMIN_TOKEN=
BBBFFL_REPLAY_OPERATOR_PASSWORD=
