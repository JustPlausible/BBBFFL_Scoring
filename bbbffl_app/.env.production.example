# Production deployment configuration (issue #243, docs/production-operations.md).
#
# Copy to bbbffl_app/.env.production, fill in every value marked
# REQUIRED/CHANGE ME, and never commit the copy (bbbffl_app/.gitignore
# already excludes .env.production). This one file is read by every
# service in compose.production.yaml that needs it (app, database, backup,
# proxy) via that file's env_file: entries -- see
# docs/production-operations.md#secrets-and-configuration for storage
# permissions/handling guidance (chmod 600, host-only, never in the image).
#
# app/config.py's get_settings() fails closed at startup if a required
# production value here is missing or invalid -- see docs/settings.md.

BBBFFL_ENVIRONMENT=production

# --- PostgreSQL (consumed directly by the "database" service, and by the
# "backup" service's pg_dump/pg_restore) ---------------------------------
# CHANGE ME: the "database" service's own image requires some non-empty
# password to initialize, so this cannot be left empty the way
# BBBFFL_ADMIN_TOKEN/BBBFFL_SESSION_SECRET below are -- but get_settings()
# still refuses to start in production if BBBFFL_DATABASE_URL below still
# embeds this exact placeholder value (issue #243 review, follow-up):
# PostgreSQL itself has no way to know this string is a public, checked-in
# value, so only the application refusing to run with it closes that gap.
POSTGRES_DB=bbbffl
POSTGRES_USER=bbbffl
POSTGRES_PASSWORD=CHANGE-ME-a-long-random-password

# Must match the three POSTGRES_* values above -- compose.production.yaml
# does not derive one from the other, so the app service and the database
# service are told the same credential explicitly rather than relying on
# compose-level variable substitution (which env_file: values do not
# participate in -- see docs/production-operations.md).
BBBFFL_DATABASE_URL=postgresql+psycopg://bbbffl:CHANGE-ME-a-long-random-password@database/bbbffl

# --- BBBFFL application secrets/URLs -------------------------------------
# The externally reachable HTTPS URL -- must match the domain configured
# directly in deploy/production/Caddyfile (see Caddyfile.example; Caddy
# itself reads no setting from this file at all).
BBBFFL_PUBLIC_BASE_URL=https://CHANGE-ME.example.com

# REQUIRED in production -- left empty deliberately (not "CHANGE-ME"), so
# a copy where this was never filled in fails closed at startup instead of
# running with a literal, publicly-documented value as its admin token
# (get_settings() also refuses "CHANGE-ME" outright if it is pasted back
# in here anyway -- issue #243 review). Shared secret for the legacy
# X-Admin-Token header (app/routes/admin.py). Generate with:
# openssl rand -hex 32
BBBFFL_ADMIN_TOKEN=

# REQUIRED in production -- same reasoning as BBBFFL_ADMIN_TOKEN above;
# also refuses the development placeholder. Signs coach sign-in/sign-out
# CSRF tokens (app/csrf.py). Generate with: openssl rand -hex 32
BBBFFL_SESSION_SECRET=

# --- afl-api (the live 2027 AFL data dependency) -------------------------
AFL_API_BASE_URL=https://CHANGE-ME-afl-api.example.net
AFL_API_KEY=CHANGE-ME-if-afl-api-requires-one
BBBFFL_AFL_MODE=live

BBBFFL_LOG_LEVEL=INFO
BBBFFL_READINESS_TIMEOUT_SECONDS=5

# --- Scheduled backups (the "backup" service, deploy/production/scripts) --
# crond schedule expression for the backup service's crontab (default:
# daily at 02:15 UTC -- see docs/production-operations.md#backup-schedule-
# and-retention for why).
BBBFFL_BACKUP_SCHEDULE=15 2 * * *
# How many days of daily backups to keep on disk before pruning.
BBBFFL_BACKUP_RETENTION_DAYS=14
# How many hours without a successful backup before the "backup" service's
# own HEALTHCHECK reports unhealthy. Widen this (and the healthcheck's
# start_period/interval in compose.production.yaml) if BBBFFL_BACKUP_SCHEDULE
# is less frequent than daily.
BBBFFL_BACKUP_MAX_AGE_HOURS=26

# Optional: a Slack (or Slack-compatible) incoming webhook URL that a
# backup failure or a failed GET /health/ready probe POSTs a short JSON
# alert to ({"text": "..."}) -- see docs/production-operations.md#alerting
# for the exact payload and what a different destination (e.g. ntfy.sh,
# whose JSON API expects a different field) would need. Leave unset to
# rely on log-only visibility (docker compose logs backup / journalctl)
# plus the backup service's own HEALTHCHECK.
BBBFFL_ALERT_WEBHOOK_URL=
